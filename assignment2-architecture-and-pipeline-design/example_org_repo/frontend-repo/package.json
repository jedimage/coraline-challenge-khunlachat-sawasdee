{
  "name": "dating-with-jedi-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test test/*.test.ts",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist --project-name dating-with-jedi"
  },
  "dependencies": { "react": "^19.1.0", "react-dom": "^19.1.0" },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vite": "^6.4.0",
    "wrangler": "^4.0.0"
  }
}
